{
  "description": "Graph query gold cases with stable node identities and row-backed evidence over the seeded source-of-truth facts.",
  "cases": [
    {
      "name": "direct-call-path",
      "mode": "path",
      "entity": "pkg.client.Client",
      "target": "pkg.client.Client.send",
      "relation_types": ["call"],
      "expected_seed": "api:1",
      "expected_found": true,
      "expected_nodes": ["api:1", "api:2"],
      "expected_relations": ["call"],
      "expected_evidence_refs": ["call_instances:1@1:default"],
      "expected_truncated": false,
      "edges_from_seed_only": false
    },
    {
      "name": "ordered-pattern-edge",
      "mode": "neighbors",
      "entity": "pkg.client.Client",
      "direction": "forward",
      "depth": 1,
      "relation_types": ["pattern_next"],
      "expected_seed": "api:1",
      "expected_nodes": ["api:1", "api:2"],
      "expected_relations": ["pattern_next"],
      "expected_evidence_refs": ["seq_patterns:1@1:default"],
      "expected_truncated": false,
      "edges_from_seed_only": true
    },
    {
      "name": "strong-document-mentions",
      "mode": "neighbors",
      "entity": "pkg.client.Client.send",
      "direction": "backward",
      "relation_types": ["mentions"],
      "expected_seed": "api:2",
      "expected_nodes": ["api:2", "doc:1"],
      "forbidden_nodes": ["doc:2"],
      "expected_relations": ["mentions"],
      "expected_evidence_refs": ["doc_api_links:1@1:default"],
      "expected_truncated": false,
      "edges_from_seed_only": false
    },
    {
      "name": "cluster-siblings",
      "mode": "community",
      "entity": "pkg.client.Client.send",
      "relation_types": ["member"],
      "expected_seed": "api:2",
      "expected_nodes": [
        "api:2",
        "api:4",
        "cluster:1:4",
        "feature:1:pkg.client.send"
      ],
      "expected_relations": ["member"],
      "expected_evidence_refs": [
        "api_clusters:1@1:default",
        "api_clusters:2@1:default",
        "doc_feature_node_links:1@1:default"
      ],
      "expected_truncated": false,
      "edges_from_seed_only": false
    },
    {
      "name": "file-level-impact",
      "mode": "impact",
      "entity": "pkg.client.Client",
      "relation_types": ["call"],
      "expected_seed": "api:1",
      "expected_nodes": ["api:1", "file:1:pkg/script.py"],
      "expected_relations": ["call"],
      "expected_evidence_refs": ["call_instances:4@1:default"],
      "expected_truncated": false,
      "edges_from_seed_only": false
    }
  ]
}
