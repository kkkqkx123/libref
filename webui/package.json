{
  "name": "libref-webui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "vue-tsc --noEmit && node scripts/gen-api.mjs --check && node --experimental-strip-types --no-warnings scripts/check-i18n.mjs && node scripts/check-design-tokens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "node scripts/gen-api.mjs",
    "check:api": "node scripts/gen-api.mjs --check",
    "check:i18n": "node --experimental-strip-types --no-warnings scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^0.2.7",
    "element-plus": "^2.9.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^19.0.2",
    "openapi-typescript": "^7.8.0",
    "typescript": "~5.6.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
