# 复制为 .env 并填入真实值；.env 本体不进版本库
# Embedding 主后端：SiliconFlow 免费 BAAI/bge-m3（OpenAI 兼容 /v1/embeddings）
LIBREF_EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
LIBREF_EMBEDDING_API_KEY=sk-replace-me
LIBREF_EMBEDDING_MODEL=BAAI/bge-m3
LIBREF_EMBEDDING_DIM=1024
LIBREF_EMBED_BATCH=64
# Rerank 同系列配对模型，默认关闭，由基准裁决是否开启；基址与密钥复用嵌入同值
LIBREF_RERANK_MODEL=BAAI/bge-reranker-v2-m3
LIBREF_RERANK_ENABLED=false
LIBREF_RERANK_CANDIDATE_LIMIT=30
LIBREF_RERANK_TOP_N=10
LIBREF_RERANK_TRUNCATE=500
# 融合检索调参：排名融合常数与双路权重、频次加成上限
LIBREF_RRF_K=20
LIBREF_RRF_W_FTS=1.0
LIBREF_RRF_W_VEC=0.5
LIBREF_FREQ_ALPHA=0.15
LIBREF_CLUSTER_ALPHA=0.05
LIBREF_CANDIDATE_MULTIPLIER=3
LIBREF_ASSEMBLE_MULTIPLIER=2
LIBREF_ASSEMBLE_MIN=10
LIBREF_RETRIEVAL_MAX_VERSIONS=8
LIBREF_SNIPPET_RADIUS=60
LIBREF_SNIPPET_CAP=400
LIBREF_WINDOW_PREVIEW_CAP=300
LIBREF_FTS_W_CONTENT=1.0
LIBREF_FTS_W_TITLE=5.0
LIBREF_FTS_W_URL=1.0
LIBREF_FTS_W_PATH=3.0
LIBREF_CLUSTER_THRESHOLD=0.15
LIBREF_CLUSTER_MIN_SIZE=2
LIBREF_EVIDENCE_PER_FILE_LIMIT=1
LIBREF_EVIDENCE_DEDUP=true
LIBREF_INDUCTION_ENABLED=false
LIBREF_INDUCTION_TOPN=20
LIBREF_INDUCTION_BATCH=8
LIBREF_INDUCTION_PROMPT_VERSION=v1
# Chat 默认禁用，待指定免费问答模型后再填；密钥缺省时回落到嵌入密钥
LIBREF_CHAT_MODEL=Qwen/Qwen3.5-4B
LIBREF_CHAT_ENABLED=false
LIBREF_CHAT_API_BASE=https://api.siliconflow.cn/v1
LIBREF_CHAT_API_KEY=
LIBREF_CHAT_TIMEOUT=60.0
LIBREF_CHAT_ENABLE_THINKING=false
LIBREF_MATERIAL_LIMIT=1500
# 向量索引：默认本地 simvec，Qdrant 为可选后端；集合名两后端共用
LIBREF_QDRANT_URL=http://localhost:6333
LIBREF_VECTOR_COLLECTION=libref_chunks
LIBREF_QDRANT_TIMEOUT=5.0
# 本地 simvec 后端（默认）：目录与动态库缺省为空，由后端自行解析
#LIBREF_VECTOR_BACKEND=simvec
#LIBREF_SIMVEC_DIR=
#LIBREF_SIMVEC_LIB=
# 抓取调参与页面治理：清洗缓存上限、浏览器等待、种子缓存有效期、站内链接跟随
LIBREF_INGEST_CLEAN_CACHE_CAP=512
#LIBREF_RENDER_WAIT_FOR=.main-content
LIBREF_RENDER_TIMEOUT_MS=15000
LIBREF_SEEDER_CACHE_TTL_HOURS=0.0
LIBREF_FOLLOW_LINKS_DEFAULT=false
# 跨注册表模糊发现：总开关、返回上限、缓存有效期、离线开关；仓库增强令牌按需填
LIBREF_DISCOVERY_ENABLED=true
LIBREF_DISCOVERY_TOPN=10
LIBREF_DISCOVERY_CACHE_TTL_DAYS=1.0
LIBREF_DISCOVERY_OFFLINE=false
#LIBREF_DISCOVERY_GITHUB_TOKEN=replace-me
# 抓取链路代理：缺省走标准 HTTP_PROXY/HTTPS_PROXY/NO_PROXY 环境变量；
# 显式值优先于环境变量，旁路缺省含本地回环（Qdrant 不进代理）
#LIBREF_HTTP_PROXY=http://127.0.0.1:7890
#LIBREF_NO_PROXY=localhost,127.0.0.1,::1
# 注册表镜像：预设值内置于代码（crawler.registry.REGISTRY_MIRRORS），env 只选预设名或手动覆盖。
# default 预设（官方源）：
#   pypi=https://pypi.org/pypi
#   npm=https://registry.npmjs.org
#   maven=https://repo1.maven.org/maven2
# cn 预设（国内组合）：
#   pypi=https://pypi.tuna.tsinghua.edu.cn/pypi
#   npm=https://registry.npmmirror.com
#   maven=https://maven.aliyun.com/repository/public
#LIBREF_REGISTRY_MIRROR=cn
# 手动覆盖（JSON，按生态逐键优先于预设，缺键回落预设）：
#LIBREF_REGISTRY_BASES={"npm": "https://registry.npmmirror.com"}
# 接口鉴权：对外暴露（非本地回环）或显式开启时必填，否则拒绝启动
#LIBREF_MCP_TOKEN=replace-me
#LIBREF_MCP_REQUIRE_AUTH=false
# 工具裁剪：允许名单减去拒绝名单；缺省全部可见，数组与逗号写法均可
#LIBREF_MCP_ENABLED_TOOLS=search,read_doc,catalog
#LIBREF_MCP_DISABLED_TOOLS=web_search,github_search
# Web 出口监听（默认只绑本地回环）
#LIBREF_WEB_HOST=127.0.0.1
#LIBREF_WEB_PORT=8001
# 运行时日志：级别与格式，文件槽缺省只走标准错误
#LIBREF_LOG_LEVEL=WARNING
#LIBREF_LOG_FILE=
#LIBREF_LOG_FORMAT=text
# 端到端解析验证：默认关闭，需显式开启才拉取真实仓库；网络失败只标记环境不可用。
# 说明见 docs/tests/parsing-verification.md，目标清单见 tests/e2e/fixtures/manifest.json。
#LIBREF_RUN_E2E=0
