# Python 字节码与缓存
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# 虚拟环境（uv 管理）
.venv/
venv/

# 测试与工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 参考仓库（只读，不参与构建；锚定仓库根目录，避免误伤 docs/ref/）
/ref/

# 环境变量与编辑器（.env.example 模板需入库，故显式放行）
.env
.env.*
!.env.example

# 本地实例配置（libref.example.toml 模板需入库，复制出的 libref.toml 不进版本库）
/libref.toml
.idea/
.vscode/

# 系统文件
.DS_Store
Thumbs.db

# 数据库文件
data/
