# Python 字节码与缓存
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# 虚拟环境（uv 管理）
.venv/
venv/

# 测试与工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 参考仓库（只读，不参与构建；锚定仓库根目录，避免误伤 docs/ref/）
/ref/

# 环境变量与编辑器（.env.example 模板需入库，故显式放行）
.env
.env.*
!.env.example

# 本地实例配置（libref.example.toml 模板需入库，复制出的 libref.toml 不进版本库）
/libref.toml
.idea/
.vscode/

# 系统文件
.DS_Store
Thumbs.db

# 依赖锁文件（各机器镜像源不同，不再跟踪，由各环境自行生成）
uv.lock

# 数据库文件
data/

# 端到端本地持久仓与审查输出（同步一次多次复用，不入库）
tests/e2e/repos/
tests/e2e/outputs/
tests/e2e/snapshots/

# retrieval benchmark dataset and reports (rebuilt from fixtures)
tests/e2e/bench/data/
tests/e2e/bench/outputs/
