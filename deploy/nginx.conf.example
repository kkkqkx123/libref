# Example reverse proxy: TLS termination + request limits + MCP streamable-http headers.
# The libref service itself never terminates TLS.
# The image bundles the SPA and serves it from its single port, so this proxy
# forwards every path and never splits API and static routes.
server {
    listen 443 ssl;
    server_name libref.example.com;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Request-body cap guards ingestion endpoints from oversized payloads.
    client_max_body_size 32m;

    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Required for MCP streamable-http long-lived responses:
        proxy_buffering off;
        proxy_set_header Connection "";
        proxy_read_timeout 3600s;
    }
}

server {
    listen 80;
    server_name libref.example.com;
    return 301 https://$host$request_uri;
}
