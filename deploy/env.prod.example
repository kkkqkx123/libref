# Enforced mode example for libref.
# Copy to the project root as .env for local runs, or to deploy/libref.env for
# the compose stack (deploy/compose.yml reads that file). Never commit real keys.
# Every request to Web routes and /mcp must carry: Authorization: Bearer <key>.

LIBREF_AUTH_MODE=enforced
LIBREF_INSTANCE_ID=prod-1

# Single combined ASGI app. Terminate TLS at the reverse proxy and bind loopback.
LIBREF_WEB_HOST=127.0.0.1
LIBREF_WEB_PORT=8001
LIBREF_MCP_PATH=/mcp

# The image bundles the frontend and sets LIBREF_WEB_SPA_DIR to /app/webui/dist.
# LIBREF_WEB_SPA_ENABLED=1
# LIBREF_WEB_SPA_DIR=/app/webui/dist

LIBREF_DB_PATH=/var/lib/libref/libref.db

# Bootstrap: on first start this creates the initial platform-admin principal
# and API key idempotently. After that, use POST /admin/keys to issue and revoke.
# Generate with: openssl rand -hex 32
# LIBREF_BOOTSTRAP_ADMIN_KEY=replace-with-random-hex

# librefctl settings: the key is read from the caller's environment and sent on every request.
LIBREF_CLIENT_API_KEY=replace-with-issued-key
LIBREF_BASE_URL=https://libref.internal

# allowed_hosts guards MCP transport; allowed_origins is the exact browser-origin
# allowlist used by auth and CORS (same-origin UI and API share one entry).
# No wildcard or path-bearing origins.
LIBREF_ALLOWED_HOSTS=libref.internal
LIBREF_ALLOWED_ORIGINS=https://libref.internal

# Issued keys expire after the default window and cannot exceed the maximum.
#LIBREF_API_KEY_DEFAULT_TTL_HOURS=168
#LIBREF_API_KEY_MAX_TTL_HOURS=8760

# Upstream LLM and registry keys: environment only, never in libref.toml.
# After changing them, call POST /admin/config/refresh to rebuild the snapshot.
# LIBREF_EMBEDDING_API_KEY=
# LIBREF_CHAT_API_KEY=
# LIBREF_DISCOVERY_GITHUB_TOKEN=

LIBREF_LOG_LEVEL=INFO
LIBREF_LOG_FORMAT=json
