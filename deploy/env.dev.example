# Development mode example for libref.
# Copy to the project root as .env, or export these variables before starting.
# Dev mode is explicit and never a production fallback. The ASGI middleware
# injects a fixed platform Principal and skips API key checks.
# Startup refuses dev mode unless the listen address is loopback.

LIBREF_AUTH_MODE=dev
LIBREF_DEV_PRINCIPAL=dev-operator
LIBREF_INSTANCE_ID=dev-1

# Single combined ASGI app: Web routes plus MCP mounted at /mcp.
LIBREF_WEB_HOST=127.0.0.1
LIBREF_WEB_PORT=8001
LIBREF_MCP_PATH=/mcp

# Local source runs have no bundled dist; point this at webui/dist to serve the SPA.
#LIBREF_WEB_SPA_DIR=./webui/dist

LIBREF_DB_PATH=./data/libref.db

# Upstream LLM and registry keys still come from the environment only.
# They are never written into libref.toml (see .env.example for the full list).
# LIBREF_EMBEDDING_API_KEY=
# LIBREF_CHAT_API_KEY=
# LIBREF_DISCOVERY_GITHUB_TOKEN=

# CLI remote mode. No key is required while the server runs in dev mode.
# LIBREF_CLIENT_API_KEY=
# LIBREF_BASE_URL=http://127.0.0.1:8001

# DNS rebinding protection is not needed on loopback.
# LIBREF_ALLOWED_HOSTS=
# LIBREF_ALLOWED_ORIGINS=

LIBREF_LOG_LEVEL=INFO
LIBREF_LOG_FORMAT=text
